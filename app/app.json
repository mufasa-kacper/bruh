{
  "expo": {
    "name": "Little Life",
    "slug": "little-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.littlelife.noodle",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick photos of your memories to hang on Noodle's wall. They stay on your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DAE3D0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.littlelife.noodle"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#EAE3E1"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos of your memories to hang on Noodle's wall. They stay on your phone."
        }
      ]
    ],
    "scheme": "littlelife",
    "backgroundColor": "#EAE3E1"
  }
}